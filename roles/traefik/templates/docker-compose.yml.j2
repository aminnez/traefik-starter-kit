services:
  traefik:
    image: "traefik:{{ traefik_image_tag | default('v3') }}"
    container_name: traefik
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
{% if traefik_docker_api_version is defined or ((traefik_acme_challenge_type | default('http')) == 'dns' and traefik_cf_dns_api_token is defined and (traefik_cf_dns_api_token | length > 0)) %}
    environment:
{% if traefik_docker_api_version is defined %}
      - DOCKER_API_VERSION={{ traefik_docker_api_version }}
{% endif %}
{% if (traefik_acme_challenge_type | default('http')) == 'dns' and traefik_cf_dns_api_token is defined and (traefik_cf_dns_api_token | length > 0) %}
      - CF_DNS_API_TOKEN={{ traefik_cf_dns_api_token }}
{% endif %}
{% endif %}
    volumes:
{% if not traefik_socket_proxy_enabled | default(true) %}
      - /var/run/docker.sock:/var/run/docker.sock:ro
{% endif %}
      - {{ traefik_install_dir }}/traefik.yml:/etc/traefik/traefik.yml:ro
      - {{ traefik_install_dir }}/acme:/etc/traefik/acme:rw
      - {{ traefik_install_dir }}/dynamic:/etc/traefik/dynamic:ro
{% if traefik_socket_proxy_enabled | default(true) %}
    depends_on:
      - docker-proxy
{% endif %}
    networks:
      - {{ traefik_network_name }}

{% if traefik_socket_proxy_enabled | default(true) %}
  docker-proxy:
    image: "{{ traefik_socket_proxy_image | default('tecnativa/docker-socket-proxy:latest') }}"
    container_name: traefik-docker-proxy
    restart: unless-stopped
    environment:
      - CONTAINERS=1
      - SERVICES=1
      - NETWORKS=1
      - TASKS=1
      - POST=0
      - DELETE=0
      - PUT=0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - {{ traefik_network_name }}
{% endif %}

{% if traefik_sablier_enabled | default(false) %}
  sablier:
    image: "{{ traefik_sablier_image | default('sablierapp/sablier:latest') }}"
    container_name: sablier
    restart: unless-stopped
    command:
      - start
      - --provider.name=docker
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - {{ traefik_network_name }}
{% endif %}

{% if traefik_deploy_whoami | default(true) %}
  whoami:
    image: traefik/whoami:latest
    container_name: traefik-whoami
    restart: unless-stopped
    networks:
      - {{ traefik_network_name }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.whoami.rule=Host(`{{ traefik_whoami_subdomain }}.{{ traefik_base_domain }}`)"
      - "traefik.http.routers.whoami.entrypoints=websecure"
      - "traefik.http.routers.whoami.tls=true"
      - "traefik.http.routers.whoami.tls.certresolver=myresolver"
      - "traefik.http.services.whoami.loadbalancer.server.port=80"
{% if traefik_sablier_enabled | default(false) and traefik_whoami_sablier_enabled | default(true) %}
      - "sablier.enable=true"
      - "sablier.group={{ traefik_whoami_sablier_group | default(traefik_whoami_subdomain) }}"
      - "traefik.docker.allownonrunning=true"
      - "traefik.http.middlewares.whoami-sablier.plugin.sablier.sablierUrl={{ traefik_sablier_url | default('http://sablier:10000') }}"
      - "traefik.http.middlewares.whoami-sablier.plugin.sablier.group={{ traefik_whoami_sablier_group | default(traefik_whoami_subdomain) }}"
      - "traefik.http.middlewares.whoami-sablier.plugin.sablier.sessionDuration={{ traefik_whoami_sablier_session_duration | default(traefik_sablier_default_session_duration | default('5m')) }}"
      - "traefik.http.middlewares.whoami-sablier.plugin.sablier.dynamic.displayName={{ traefik_whoami_sablier_display_name | default('Whoami Service') }}"
      - "traefik.http.middlewares.whoami-sablier.plugin.sablier.dynamic.theme={{ traefik_whoami_sablier_theme | default(traefik_sablier_default_theme | default('hacker-terminal')) }}"
      - "traefik.http.routers.whoami.middlewares=whoami-sablier"
{% endif %}
{% endif %}

networks:
  {{ traefik_network_name }}:
    external: true
