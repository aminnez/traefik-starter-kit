# Traefik Starter Kit - Environment Variables Example
# Copy this file to .env and configure your values:
#   cp .env.example .env

# Required Domain & ACME settings
TRAEFIK_BASE_DOMAIN=example.com
TRAEFIK_ACME_EMAIL=admin@example.com

# Dashboard Credentials
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=ChangeMeToAStrongPassword!

# Optional Subdomain Override (default: traefik)
# TRAEFIK_DASHBOARD_SUBDOMAIN=traefik
